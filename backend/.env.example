# Copy to backend/.env (never commit .env). Real environment variables override this file.

# development | production
APP_ENV=development
# Required in production: a long random string (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Database (defaults to SQLite at backend/instance/planit.db)
# DATABASE_URL=postgresql://user:pass@host/planit

# Contact email sent in the User-Agent to public data APIs (NWS asks for one)
CONTACT_EMAIL=

# AI assistant: set ONE key (server only, never in the frontend).
# Gemini, free tier available (free-tier prompts may be used by Google to improve its products):
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# With both keys set, Claude answers unless ASSISTANT_PROVIDER=gemini (auto | claude | gemini).
# ASSISTANT_PROVIDER=auto

# Background jobs
# ENABLE_JOBS=true
# WEATHER_REFRESH_MINUTES=60
# LIGHTNING_SOURCE=glm          (or "off" to skip NOAA satellite lightning, ~1 MB/min)
# GLM_SATELLITES=goes19         (add ,goes18 for better West Coast coverage)

# Demo helpers (default on in development, off in production)
# DEMO_TOOLS=true
# SEED_DEMO_USERS=true
# DEMO_PASSWORD=planit-demo

# Email (SMTP). Leave SMTP_HOST empty to only record emails in the outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS (Twilio). Leave empty to only record texts in the outbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Phone and desktop notifications (Web Push). Nothing to set up: the signing key is created on
# first start in instance/vapid_private_key.pem. Keep that file, or every device must turn notifications on again.
# VAPID_SUBJECT=mailto:you@example.com      (a contact the push services can reach)
# VAPID_PRIVATE_KEY_FILE=instance/vapid_private_key.pem

# Open-Meteo commercial API key (optional; the free tier is for non-commercial use)
# OPEN_METEO_API_KEY=
