# Copy to `.env` and adjust.

# Base URL of the Flask REST API. "/api" uses the Vite dev proxy (see vite.config.js).
VITE_API_BASE_URL=/api

# true  = use the in-browser mock data in src/mocks (no backend needed)
# false = call the real REST API (backend must implement docs/API_PLAN.md)
VITE_USE_MOCKS=true
