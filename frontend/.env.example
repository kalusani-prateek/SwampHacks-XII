# Copy to `.env` (or `.env.local`) to override the defaults.

# Base URL of the Flask REST API. "/api" uses the Vite dev proxy (see vite.config.js)
# and is same-origin when Flask serves the built app.
VITE_API_BASE_URL=/api

# auto  = use the backend if it answers at startup, otherwise demo data (default)
# true  = always use the in-browser demo data in src/mocks (no backend needed)
# false = always use the real REST API (docs/API.md)
VITE_USE_MOCKS=auto
